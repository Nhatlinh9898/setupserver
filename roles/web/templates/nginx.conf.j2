# Nginx site config — quản lý bởi Ansible (role web)
server {
    listen 80 default_server;
    listen [::]:80 default_server;

    server_name {{ domain_name | default('_') }};
    root /var/www/html;
    index index.html index.htm;

    access_log /var/log/nginx/access.log;
    error_log /var/log/nginx/error.log;

    location / {
        try_files $uri $uri/ =404;
    }

{% if ssl_enabled | default(false) %}
    # TLS: thêm certificate paths thật trước khi bật ssl_enabled
    # listen 443 ssl http2;
    # ssl_certificate     /etc/ssl/certs/CHANGE_ME.crt;
    # ssl_certificate_key /etc/ssl/private/CHANGE_ME.key;
{% endif %}
}
